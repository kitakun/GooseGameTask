{
  "name": "the-last-of-guss",
  "version": "1.0.0",
  "description": "Browser game where players compete to tap a virtual goose",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "kill": "taskkill /f /im node.exe",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

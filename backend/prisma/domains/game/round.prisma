// Game Domain - Round management and game state

model Round {
  id          String    @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations to other domains
  taps        Tap[]

  @@map("rounds")
}

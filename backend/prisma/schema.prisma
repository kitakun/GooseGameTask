
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== GENERATED SCHEMA FROM DDD DOMAINS =====
// This file is auto-generated from domain-specific schema files
// Do not edit this file directly - edit the files in the domains/ folder
// Generated at: 2025-09-13T21:22:47.317Z


// ===== USER DOMAIN =====
// User Domain - User management and authentication

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to other domains
  taps         Tap[]
  achievements Achievement[]

  @@map("users")
}


// ===== GAME DOMAIN =====
// Game Domain - Round management and game state

model Round {
  id          String    @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations to other domains
  taps        Tap[]

  @@map("rounds")
}


// ===== INTERACTION DOMAIN =====
// Interaction Domain - User interactions with the game

model Tap {
  id        String   @id @default(cuid())
  userId    String
  roundId   String
  tapCount  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to other domains
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  round     Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([userId, roundId])
  @@map("taps")
}


// ===== ACHIEVEMENT DOMAIN =====
// Achievement Domain - User achievements and rewards

model Achievement {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?  // Icon emoji or URL
  points      Int      @default(0) // Points awarded for achievement
  userId      String
  unlockedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  // Relations to other domains
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}


{
  "name": "the-last-of-guss-backend",
  "version": "1.0.0",
  "description": "Backend for The Last of Guss game",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register src/app/index.ts\" --watch src --ext ts,js",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:init": "node scripts/init-db.js",
    "schema:build": "node scripts/build-schema.js",
    "schema:rebuild": "npm run schema:build && npm run db:push",
    "lint": "eslint src --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^9.1.0",
    "@fastify/cors": "^8.4.0",
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "eventstore": "^1.15.5",
    "fastify": "^4.24.3",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^5.8.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "nodemon": "^3.1.10",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  }
}
